    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是文件夹，本身没有像素。请在其中的图层上绘画，或在文件夹的蒙版上绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是檔案夾，本身沒有像素。請在其中的圖層上繪畫，或在檔案夾的遮色片上繪畫。"
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是调整图层，没有可绘画的像素。请改为在其蒙版上绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是調整圖層，沒有可繪畫的像素。請改為在其遮色片上繪畫。"
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已隐藏，或位于隐藏的文件夹中。显示后才能在其上绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已隱藏，或位於隱藏的檔案夾中。顯示後才能在其上繪畫。"
          }
        }
      }
    },
