    "Use 1–%@ pixels per side, up to %lld megapixels, and 1–9,600 pixels/inch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use 1–%1$@ pixels per side, up to %2$lld megapixels, and 1–9,600 pixels/inch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边 1–%@ 像素，最多 %lld 百万像素，分辨率 1–9,600 像素/英寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每邊 1–%@ 像素，最多 %lld 百萬像素，解析度 1–9,600 像素/英寸。"
          }
        }
      }
    },
    "Use gridlines every %lld–%@ pixels and %lld–%lld subdivisions, no more than the pixels between gridlines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use gridlines every %1$lld–%2$@ pixels and %3$lld–%4$lld subdivisions, no more than the pixels between gridlines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格线间隔为 %lld–%@ 像素，子网格数为 %lld–%lld，且不超过网格线之间的像素数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格點間隔為 %lld–%@ 像素，細分數為 %lld–%lld，且不超過格點之間的像素數。"
          }
        }
      }
    },
