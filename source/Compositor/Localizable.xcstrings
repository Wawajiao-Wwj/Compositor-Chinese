          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加大或减小明暗色调的差异，主要作用于中间调。"
