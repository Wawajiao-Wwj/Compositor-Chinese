    "Tones from black on the left to white on the right: blacks, shadows, midtones, highlights, whites. Control-click to show the vectorscope.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左侧黑色到右侧白色的色调：黑色、阴影、中间调、高光、白色。按住 Control 点按可显示矢量示波器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從左側黑色到右側白色的色調：黑色、陰影、中間調、亮部、白色。按住 Control 鍵按一下可顯示向量示波器。"
          }
        }
      }
    },
