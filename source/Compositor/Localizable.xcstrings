    "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值拉直向外凸的线条（桶形）；负值拉直向内凹的线条（枕形）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值拉直向外凸的線條（桶狀）；負值拉直向內凹的線條（枕狀）。"
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值使检测到的蒙版向内收紧；负值使其向外扩展"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值使偵測到的遮色片向內收緊；負值使其向外擴張"
          }
        }
      }
    },
    "Preserve Luminosity": {
      "localizations": {
        "zh-Hans": {
