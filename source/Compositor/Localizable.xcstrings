    "Bake keeps the current masked appearance in the dependent layers’ pixels. Remove Links reveals their pixels. You can undo either choice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“烘焙”会把当前的蒙版效果保留在依赖图层的像素中；“移除链接”会显示它们的全部像素。两种选择都可以撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「烘焙」會把目前的遮色片效果保留在依賴圖層的像素中；「移除連結」會顯示它們的全部像素。兩種選擇都可以復原。"
          }
        }
      }
    },
