        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕掃描線之間的間距"
          }
        }
      }
    },
    "How far each color channel (0–255) can differ from the clicked color and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个颜色通道 (0–255) 与点按的颜色相差多少仍会被选中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個顏色色版 (0–255) 與按一下的顏色相差多少仍會被選取"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锐化从各边缘延伸的距离（像素）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
