    "Adds film grain, strongest in the middle tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，在中间调最明显。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增加底片顆粒，在中間調最明顯。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最暗的色调添加绿色或洋红。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為最暗的色調增加綠色或洋紅。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加或柔化较大形状边缘的对比度。"
