    "Make each dithered pixel this many pixels across, for a chunky old-screen look": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每个抖动像素的宽度为此像素数，营造粗颗粒的老屏幕效果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
